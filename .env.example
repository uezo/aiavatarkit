# AIAvatarKit built-in CLI application configuration
#
# These AIAVATAR_* settings configure `aiavatar` when no application script is
# supplied. The values below are the built-in defaults, so copying this file
# without changing them preserves the standard behavior.
#
# The minimal setup is OPENAI_API_KEY plus a reachable VOICEVOX-compatible
# server at http://127.0.0.1:50021. The `aiavatar` command automatically loads
# `.env` from the current working directory without replacing variables already
# present in the process environment:
#
#   cp .env.example .env
#   # Edit OPENAI_API_KEY in .env
#   aiavatar
#
# `.env` is ignored by Git. Never put real credentials in this example file or
# commit a populated copy. Command-line options override their corresponding
# environment variables; component-specific OpenAI settings override the
# shared OPENAI_* values.
# Boolean values accept true/false, yes/no, on/off, or 1/0.


# Log component-level diagnostics. Disable this for quieter normal operation.
AIAVATAR_DEBUG=true


# -----------------------------------------------------------------------------
# Shared OpenAI defaults
# -----------------------------------------------------------------------------
# OPENAI_API_KEY is normally the only required environment setting. When it is
# absent, an interactive CLI prompts securely; non-interactive startup fails.
# It is shared by STT, LLM, OpenAI TTS, and the alphabet-to-kana preprocessor
# unless a component-specific override below is set.
#
# Leave OPENAI_BASE_URL empty for OpenAI. Set it to an OpenAI-compatible API
# base, normally ending in /v1, when all OpenAI components share one provider.

OPENAI_API_KEY=
OPENAI_BASE_URL=


# -----------------------------------------------------------------------------
# OpenAI STT
# -----------------------------------------------------------------------------
# Optional STT-only credentials and endpoint. Empty values fall back to the
# shared OPENAI_* settings above. This allows STT, LLM, and TTS to use different
# providers or accounts.

AIAVATAR_STT_OPENAI_API_KEY=
AIAVATAR_STT_OPENAI_BASE_URL=

# Transcription model sent to the configured OpenAI-compatible STT endpoint.
AIAVATAR_STT_MODEL=gpt-transcribe

# Language hint such as ja or en. Use auto, none, null, or an empty value to let
# the transcription provider detect the language automatically.
AIAVATAR_STT_LANGUAGE=auto


# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
# Select responses-websocket for low-latency OpenAI Responses streaming, or
# chat-completions for providers that only implement that API.

AIAVATAR_LLM_API=responses-websocket

# Optional LLM-only credentials and endpoint. Empty values use OPENAI_*.
AIAVATAR_LLM_OPENAI_API_KEY=
AIAVATAR_LLM_OPENAI_BASE_URL=

# Model identifier passed unchanged to the selected LLM API.
AIAVATAR_LLM_MODEL=gpt-5.6-terra

# JSON array of XML tag names whose contents are sent to TTS. With the default
# prompt, <ack> and <answer> are spoken while <think> remains unspoken.
AIAVATAR_LLM_VOICE_TEXT_TAGS='["ack","answer"]'

# Uncomment to replace the built-in voice-assistant system prompt completely.
# Keep the value shell-quoted; the command does not interpret escape sequences.
# AIAVATAR_LLM_SYSTEM_PROMPT='You are a helpful voice assistant.'

# Optional JSON object forwarded as extra_body. Use this for provider-specific
# options such as disabling thinking. When non-empty, the default
# reasoning_effort="none" is omitted unless explicitly set below.
# AIAVATAR_LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# Empty means reasoning_effort="none" without extra_body, and omitted with a
# non-empty extra_body. Set a supported value such as low/medium/high to send
# it explicitly, or set omit/null to never include the parameter.
AIAVATAR_LLM_REASONING_EFFORT=


# -----------------------------------------------------------------------------
# TTS providers and shared provider defaults
# -----------------------------------------------------------------------------
# Speech with no language tag or a Japanese language tag uses the ja route;
# every other language uses the multi route. Each route independently supports
# voicevox, openai, or instant.
#
# Route configs are JSON objects containing provider constructor options and
# override the shared provider defaults below. Japanese enables
# alphabet_to_kana by default; multi disables it. Set "alphabet_to_kana"
# explicitly in a route config to change that behavior.

AIAVATAR_JA_TTS=voicevox
AIAVATAR_JA_TTS_CONFIG='{}'
AIAVATAR_MULTI_TTS=openai
AIAVATAR_MULTI_TTS_CONFIG='{}'

# OpenAI TTS credentials and endpoint. Empty values fall back to OPENAI_*.

AIAVATAR_TTS_OPENAI_API_KEY=
AIAVATAR_TTS_OPENAI_BASE_URL=

# Model and voice used by routes whose provider is openai. Instructions control
# delivery only; the LLM remains responsible for the response text.
AIAVATAR_OPENAI_TTS_MODEL=gpt-4o-mini-tts
AIAVATAR_OPENAI_TTS_SPEAKER=sage
AIAVATAR_OPENAI_TTS_INSTRUCTIONS='Speak naturally in the language of the input text, using a clear, friendly, conversational tone and a moderate pace.'

# Cache paths are relative to the working directory. Set empty, none, or null
# to disable caching for that provider.
AIAVATAR_OPENAI_TTS_CACHE_DIR=ttscache/openai

# VOICEVOX-compatible server defaults. SPEAKER is the numeric speaker/style ID
# exposed by the server's /speakers endpoint.
AIAVATAR_VOICEVOX_URL=http://127.0.0.1:50021
AIAVATAR_VOICEVOX_SPEAKER=46
AIAVATAR_VOICEVOX_CACHE_DIR=ttscache/voicevox

# Instant TTS performs one HTTP request and uses its raw response body as PCM
# WAV audio. It supports method, url, params, headers, json, timeout,
# sample_rate, follow_redirects, cache_dir, and cache_ext. Use {text} and
# {language} placeholders in request values. For example, Aivis Cloud
# authentication is placed directly in headers:
# AIAVATAR_JA_TTS=instant
# AIAVATAR_JA_TTS_CONFIG='{"method":"POST","url":"https://api.aivis-project.com/v1/tts/synthesize","headers":{"Authorization":"Bearer YOUR_AIVIS_API_KEY","Content-Type":"application/json"},"json":{"model_uuid":"YOUR_MODEL_UUID","text":"{text}","output_format":"wav","output_sampling_rate":16000,"output_audio_channels":"mono","use_ssml":false},"cache_dir":"ttscache/aivis"}'


# -----------------------------------------------------------------------------
# Voice activity and turn-end detection
# -----------------------------------------------------------------------------

# Initial ambient-noise estimate in dBFS for the near-field audio gate. It is
# used before enough session audio has been collected and is not a speech-volume
# threshold. A value closer to 0 assumes a louder environment.
AIAVATAR_NEAR_FIELD_INITIAL_AMBIENT_DB=-30.0

# JSON array of filler phrases that should keep the turn open, such as "um".
# Leave empty to use the built-in Japanese and English lists. TIMEOUT is the
# maximum additional hold in seconds after a filler is detected.
AIAVATAR_FILLER_PHRASES=
FILLER_TURN_GATE_TIMEOUT=3.0

# Namo confirms whether recognized text sounds complete. Use auto, none, null,
# or an empty language to select the multilingual model. A language code such
# as ja selects its language-specific model.
AIAVATAR_NAMO_LANGUAGE=auto

# End-of-turn probability threshold from 0 to 1. Higher values require stronger
# evidence and therefore keep the turn open more often. TIMEOUT is the maximum
# additional hold in seconds when Namo judges the utterance incomplete.
NAMO_TURN_THRESHOLD=0.5
NAMO_TURN_GATE_TIMEOUT=1.0

# JSON array of complete utterances that bypass Namo and immediately end the
# turn. Matching ignores case, width, whitespace, punctuation, and symbols, but
# remains an exact whole-utterance match.
AIAVATAR_NAMO_FORCE_END_PHRASES='["こんにちは。"]'

# Seconds of silence before the current recording becomes a turn-end candidate.
# Larger values tolerate longer pauses but increase response latency.
AIAVATAR_VAD_SILENCE_DURATION_THRESHOLD=0.5

# Seconds of silence used to split an in-progress recording for partial STT.
# Smaller values update partial text sooner but can increase STT requests.
AIAVATAR_VAD_SEGMENT_SILENCE_THRESHOLD=0.05

# Use Silero's stateful streaming iterator and its boundary smoothing. Disable
# only when direct per-chunk probability detection is preferred.
AIAVATAR_VAD_USE_ITERATOR=true

# Namo downloads and caches its model on first use. An optional Hugging Face
# token avoids unauthenticated download warnings and provides higher rate limits.
# HF_TOKEN=


# -----------------------------------------------------------------------------
# Pipeline and WebSocket adapter
# -----------------------------------------------------------------------------

# Insert the current timestamp into the LLM context after this many seconds.
# Set 0 to disable. TIMEZONE must be an IANA name such as Asia/Tokyo or UTC.
AIAVATAR_TIMESTAMP_INTERVAL_SECONDS=600.0
AIAVATAR_TIMESTAMP_TIMEZONE=Asia/Tokyo

# Merge mergeable requests received within this many seconds so short,
# consecutive utterances are interpreted together. Set 0 to disable.
AIAVATAR_MERGE_REQUEST_THRESHOLD=3.0

# Process overlapping requests through a per-session queue instead of running
# them concurrently. This provides predictable ordering for rapid input.
AIAVATAR_USE_INVOKE_QUEUE=true

# Stop current response audio as soon as new speech recording starts, rather
# than waiting until the new request has completed speech recognition.
AIAVATAR_MUTE_ON_BARGE_IN=true
